{
  "name": "promptly",
  "version": "0.1.0",
  "description": "The best local-first BYOK selection-to-AI assistant for Windows",
  "main": "out/main/index.js",
  "author": "onesun2012",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:helper": "node scripts/build-helper.mjs",
    "dev": "npm run build:helper && electron-vite dev",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:dir": "npm run build:helper && npm run build && electron-builder --dir",
    "dist": "npm run build:helper && npm run build && electron-builder --win"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
